{
  "name": "artiore-github-io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/build-claims.py && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/write-route-html.mjs && node scripts/check-dist.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:evidence": "python3 scripts/test_validate_evidence.py && python3 scripts/validate-evidence.py data/evidence/ledger-v1/example-record.json data/evidence/ledger-v1/example-list.json",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "prepare:images": "python3 scripts/prepare-images.py",
    "pretest": "python3 scripts/prepare-images.py",
    "prebuild": "python3 scripts/prepare-images.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
