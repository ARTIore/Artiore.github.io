{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artiais.com/schemas/evidence-ledger-v1.json",
  "title": "ARTIore Evidence Ledger document v1",
  "description": "One evidence record, or a list of records. Normative checks live in src/lib/evidence/validate.ts and scripts/validate-evidence.py. A date-time must be a real RFC 3339 instant with a timezone. A URL must be http or https, with no userinfo and no javascript:, data:, vbscript:, file:, or blob: scheme. PUBLISHED and APPROVED require human_approval. CORRECTED requires revision history that keeps the previous wording. DISPUTED requires conflicting evidence. VERIFIED requires a method, a time, and at least one source.",
  "oneOf": [
    { "$ref": "#/$defs/record" },
    { "$ref": "#/$defs/recordList" }
  ],
  "$defs": {
    "safeUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Absolute http or https URL. Validators also reject userinfo and unsafe schemes such as javascript:."
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Validators also reject impossible calendar dates."
    },
    "recordList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/record" }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "approved_at", "action"],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "approved_at": { "$ref": "#/$defs/dateTime" },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "source_type", "accessed_at"],
      "properties": {
        "url": { "$ref": "#/$defs/safeUrl" },
        "source_type": { "enum": ["PRIMARY", "SECONDARY", "USER_REPORT", "OTHER"] },
        "accessed_at": { "$ref": "#/$defs/dateTime" },
        "archived_url": { "type": ["string", "null"], "format": "uri" },
        "note": { "type": "string" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "source_url": { "type": ["string", "null"] }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "summary", "previous_statement"],
      "properties": {
        "timestamp": { "$ref": "#/$defs/dateTime" },
        "summary": { "type": "string", "minLength": 1 },
        "previous_statement": {
          "type": "string",
          "minLength": 1,
          "description": "The wording this revision replaced. Do not drop it."
        },
        "previous_claim_id": { "type": "string", "pattern": "^ART-EVD-[0-9]{4,}$" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "status",
        "sources",
        "scope",
        "limitations",
        "publication_status",
        "revision_history"
      ],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^ART-EVD-[0-9]{4,}$" },
        "statement": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "VERIFIED",
            "SUPPORTED_INFERENCE",
            "DISPUTED",
            "UNVERIFIED",
            "BELIEF_INTERPRETATION",
            "CORRECTED"
          ]
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "scope": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verification_method": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"], "format": "date-time" },
        "conflicting_evidence": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
        "publication_status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "PUBLISHED", "RETRACTED"] },
        "human_approval": { "type": ["object", "null"] },
        "revision_history": { "type": "array", "items": { "$ref": "#/$defs/revision" } }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "VERIFIED" } }
          },
          "then": {
            "required": ["verification_method", "verified_at"],
            "properties": {
              "verification_method": { "type": "string", "minLength": 1 },
              "verified_at": { "$ref": "#/$defs/dateTime" },
              "sources": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "required": ["publication_status"],
            "properties": { "publication_status": { "enum": ["APPROVED", "PUBLISHED"] } }
          },
          "then": {
            "required": ["human_approval"],
            "properties": { "human_approval": { "$ref": "#/$defs/approval" } }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "CORRECTED" } }
          },
          "then": {
            "properties": { "revision_history": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "DISPUTED" } }
          },
          "then": {
            "properties": { "conflicting_evidence": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
